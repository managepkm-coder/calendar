<?xml version="1.0" encoding="utf-8"?>
<!-- 한 달이 들어가면 화면을 꽉 채우고, 모자라면 스크롤한다.
     fillViewport 는 내용이 화면보다 짧을 때만 화면 높이만큼 늘려 주므로,
     그때는 아래 무게가 살아 주 줄이 높이를 나눠 갖고, 넘칠 때는 스크롤로 넘어간다. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:padding="10dp" android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="14dp">

        <!-- 헤더: 설정 / 이전 · 년월 · 다음 / 오늘 -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">

            <TextView android:id="@+id/btnSettings"
                android:layout_width="44dp" android:layout_height="44dp"
                android:text="⚙" android:textSize="22sp" android:gravity="center"
                android:textColor="@color/text_primary"
                android:clickable="true" android:focusable="true" />

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="horizontal"
                android:gravity="center">
                <TextView android:id="@+id/prev"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="‹" android:textSize="26sp" android:padding="8dp"
                    android:textColor="@color/text_muted"
                    android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/ym"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="24sp" android:textStyle="bold"
                    android:textColor="@color/text_primary" />
                <TextView android:id="@+id/next"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="26sp" android:padding="8dp"
                    android:textColor="@color/text_muted"
                    android:clickable="true" android:focusable="true" />
            </LinearLayout>

            <TextView android:id="@+id/btnToday"
                android:layout_width="44dp" android:layout_height="44dp"
                android:text="⟳" android:textSize="22sp" android:gravity="center"
                android:textColor="@color/text_primary"
                android:clickable="true" android:focusable="true" />
        </LinearLayout>

        <TextView android:id="@+id/sub"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:textSize="12sp"
            android:textColor="@color/text_muted" android:layout_marginBottom="8dp" />

        <!-- 요일 -->
        <LinearLayout android:id="@+id/dowRow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="2dp" />

        <!-- 날짜 — 주 단위 줄을 코드에서 채운다.
             0dp 가 아니라 wrap_content + 무게라야 늘릴 자리가 없을 때 칸이 찌그러지지 않는다 -->
        <LinearLayout android:id="@+id/grid"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
