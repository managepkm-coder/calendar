<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingBottom="5dp">
        <TextView android:id="@+id/ym"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/todayInfo"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="end"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 요일 -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingBottom="2dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="일"
            android:textSize="10sp" android:textStyle="bold" android:textColor="#E0483C" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="월"
            android:textSize="10sp" android:textStyle="bold" android:textColor="@color/text_muted" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="화"
            android:textSize="10sp" android:textStyle="bold" android:textColor="@color/text_muted" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="수"
            android:textSize="10sp" android:textStyle="bold" android:textColor="@color/text_muted" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="목"
            android:textSize="10sp" android:textStyle="bold" android:textColor="@color/text_muted" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="금"
            android:textSize="10sp" android:textStyle="bold" android:textColor="@color/text_muted" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="토"
            android:textSize="10sp" android:textStyle="bold" android:textColor="#2F6FD0" />
    </LinearLayout>

    <!-- 주 단위 행이 코드에서 채워집니다 -->
    <LinearLayout android:id="@+id/weeks"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
