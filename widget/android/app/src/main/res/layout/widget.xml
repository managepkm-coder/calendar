<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget"
    android:padding="12dp">

    <!-- 오늘 | ‹ 년.월 › | 설정 — 좌우에 같은 비중을 줘서 달 이름이 가운데 온다 -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView android:id="@+id/btnToday"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="start"
            android:text="오늘" android:textSize="13sp"
            android:paddingTop="4dp" android:paddingBottom="4dp" android:paddingEnd="8dp" />

        <TextView android:id="@+id/btnPrev"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="‹" android:textSize="21sp"
            android:paddingStart="8dp" android:paddingEnd="8dp" />

        <TextView android:id="@+id/ym"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="17sp" android:textStyle="bold" />

        <TextView android:id="@+id/btnNext"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="›" android:textSize="21sp"
            android:paddingStart="8dp" android:paddingEnd="8dp" />

        <TextView android:id="@+id/btnSettings"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="end"
            android:text="⚙" android:textSize="16sp"
            android:paddingTop="4dp" android:paddingBottom="4dp" android:paddingStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingBottom="4dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="일"
            android:textSize="11sp" android:textStyle="bold" android:textColor="#E0483C" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="월"
            android:textSize="11sp" android:textStyle="bold" android:textColor="@color/text_muted" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="화"
            android:textSize="11sp" android:textStyle="bold" android:textColor="@color/text_muted" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="수"
            android:textSize="11sp" android:textStyle="bold" android:textColor="@color/text_muted" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="목"
            android:textSize="11sp" android:textStyle="bold" android:textColor="@color/text_muted" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="금"
            android:textSize="11sp" android:textStyle="bold" android:textColor="@color/text_muted" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="토"
            android:textSize="11sp" android:textStyle="bold" android:textColor="#2F6FD0" />
    </LinearLayout>

    <LinearLayout android:id="@+id/weeks"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" />
</LinearLayout>
