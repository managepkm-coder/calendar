<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget"
    android:padding="12dp">

    <!-- 달 이름을 가운데 두기 위해 좌우에 같은 비중을 준다 -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingBottom="8dp">
        <TextView android:id="@+id/todayInfo"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="start"
            android:textSize="12sp" />
        <TextView android:id="@+id/ym"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="17sp" android:textStyle="bold" />
        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingBottom="4dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="일"
            android:textSize="11sp" android:textStyle="bold" android:textColor="#E0483C" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="월"
            android:textSize="11sp" android:textStyle="bold" android:textColor="@color/text_muted" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="화"
            android:textSize="11sp" android:textStyle="bold" android:textColor="@color/text_muted" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="수"
            android:textSize="11sp" android:textStyle="bold" android:textColor="@color/text_muted" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="목"
            android:textSize="11sp" android:textStyle="bold" android:textColor="@color/text_muted" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="금"
            android:textSize="11sp" android:textStyle="bold" android:textColor="@color/text_muted" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="토"
            android:textSize="11sp" android:textStyle="bold" android:textColor="#2F6FD0" />
    </LinearLayout>

    <!-- 주 행이 코드에서 채워지며, 남는 높이를 모두 나눠 갖는다 -->
    <LinearLayout android:id="@+id/weeks"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" />
</LinearLayout>
