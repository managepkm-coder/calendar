<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cellRoot"
    android:layout_width="0dp" android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical" android:gravity="center"
    android:paddingTop="2dp" android:paddingBottom="3dp">

    <TextView android:id="@+id/cellDate"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="9sp" android:textStyle="bold" />

    <TextView android:id="@+id/cellBadge"
        android:layout_width="25dp" android:layout_height="25dp"
        android:layout_marginTop="1dp" android:gravity="center"
        android:textSize="12sp" android:textStyle="bold" />
</LinearLayout>
